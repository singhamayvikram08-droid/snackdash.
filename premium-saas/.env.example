# ═══════════════════════════════════════════════════════════════════════════════
# NEXGEN SAAS - PUBLIC CLIENT CONFIGURATION (.env.example)
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the client.
# NEVER put private API secrets, database passwords, or private keys here.
# ═══════════════════════════════════════════════════════════════════════════════

# App Environment
VITE_APP_ENV=development
VITE_APP_NAME="NexGen 3D SaaS"
VITE_APP_URL="http://localhost:5173"

# Public API Gateway (Backend/Microservices)
VITE_API_GATEWAY_URL="https://api.nexgen.io/v1"

# Telemetry / Public Analytics ID (safe for frontend)
VITE_PUBLIC_ANALYTICS_ID="nex_live_telemetry_public"
